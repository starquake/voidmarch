# Claude merges its own pull requests once they are reviewed and green, but a
# change to how work is checked, merged or deployed needs @starquake's
# approval: the ruleset requires a code owner's review (#373, decisions 8 and
# 9). Only the forms .claude/scripts/merge-gate.sh parses: /dir/, /path, and a
# bare name/ or name, which matches at any depth.
/.github/ @starquake
/deployments/ @starquake
# Claude Code reads these, and any CLAUDE.md, in any directory.
.claude/ @starquake
.mcp.json @starquake
CLAUDE.md @starquake

# The configs of the checks a merge waits for.
/Makefile @starquake
/.golangci.yml @starquake
/.testcoverage.yml @starquake
/Dockerfile @starquake
/frontend/eslint.config.js @starquake
/frontend/tsconfig.json @starquake
/frontend/playwright.config.ts @starquake
