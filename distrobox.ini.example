[voidmarch-dev]
image=quay.io/toolbx/ubuntu-toolbox:24.04
replace=true
pull=true

# gcc: go test -race needs cgo.
additional_packages="git make gcc libc6-dev curl ca-certificates xz-utils sqlite3"

# Playwright's Chromium and Firefox (make e2e-install, make test-e2e): its own Ubuntu 24.04
# list, as `npx playwright install-deps --dry-run chromium firefox` prints it. Firefox decodes
# the music with libavcodec; libpulse0 lets its audio reach the host's sound server, else the
# AudioContext stays locked. libnss3 and libasound2t64 also serve GoLand's JCEF helper.
additional_packages="libpulse0 libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libavcodec60 libcairo2 libcairo-gobject2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libgdk-pixbuf-2.0-0 libglib2.0-0t64 libgtk-3-0t64 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcb-shm0 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libfontconfig1 libfreetype6"
additional_packages="fonts-noto-color-emoji fonts-unifont fonts-liberation fonts-ipafont-gothic fonts-wqy-zenhei fonts-tlwg-loma-otf fonts-freefont-ttf xfonts-cyrillic xfonts-scalable"

## Go: the latest release in /usr/local/go, on PATH via /etc/profile.d (go.mod's toolchain line fetches a newer one if needed)
init_hooks=v=$(curl -fsSL "https://go.dev/VERSION?m=text" | head -1); if [ "$(/usr/local/go/bin/go env GOVERSION 2>/dev/null)" != "$v" ]; then curl -fsSL "https://go.dev/dl/${v}.linux-amd64.tar.gz" -o /tmp/go.tar.gz && rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tar.gz; rm -f /tmp/go.tar.gz; fi; echo "export PATH=\$PATH:/usr/local/go/bin:\$HOME/go/bin" > /etc/profile.d/go.sh;

## Node.js: the latest LTS in /usr/local (package.json needs >= 24, Ubuntu ships 18; CI uses lts/*)
init_hooks=n=$(curl -fsSL https://nodejs.org/dist/index.tab | grep -m1 -E "[[:space:]][A-Z][a-z]+[[:space:]]" | cut -f1); if [ "$(/usr/local/bin/node --version 2>/dev/null)" != "$n" ]; then curl -fsSL "https://nodejs.org/dist/${n}/node-${n}-linux-x64.tar.xz" | tar -C /usr/local -xJ --strip-components=1 --exclude=CHANGELOG.md --exclude=LICENSE --exclude=README.md; fi;

# Needed for GoLand (uncomment if needed)
#additional_packages="libxtst6 libgl1 libegl1 fonts-dejavu libwayland-client0 libwayland-cursor0 libwayland-egl1 gsettings-desktop-schemas at-spi2-core"
